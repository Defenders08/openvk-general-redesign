        <div class="album-description">
            <a href="{$owner->getURL()}" style="font-weight: bold; color: #2B587A; font-size: 12px; text-decoration: none;">{$owner->getCanonicalName()}</a>
            {$description}
            {var $editTime = $album->getEditTime()}
            {var $createTime = $album->getCreationTime()}

