{extends "../@layout.latte"}

{block title}{_album} {$album->getName()}{/block}

{block headIncludes}
    {var $albumCover = $album->getCoverPhoto()}
    {var $albumCoverUrl = !is_null($albumCover) ? $albumCover->getURLBySizeId('normal') : ''}
    <meta property="og:title" content="{$album->getName()} — {$instance_name}" />
    <meta property="og:url" content="{$baseUrl}/album{$album->getPrettyId()}" />
    <meta n:if="!empty($albumCoverUrl)" property="og:image" content="{$albumCoverUrl}" />
    <meta property="og:type" content="article" />
    <meta name="twitter:title" content="{$album->getName()} — {$instance_name}" />
    <meta n:if="!empty($albumCoverUrl)" name="twitter:image" content="{$albumCoverUrl}" />
{/block}

{block header}
    {if !is_null($thisUser) && $album->getOwner()->getId() === $thisUser->getId()} 
        {* Если альбом принадлежит текущему пользователю *}
        <a href="/albums{$thisUser->getId()}">{_my_photos}</a> » {$album->getName()} » {$album->getPhotosCount()} {tr("photos", $album->getPhotosCount())}
    {else}
        {* Если альбом принадлежит другому пользователю *}
        <a href="{$album->getOwner()->getURL()}">{$album->getOwner()->getCanonicalName()}</a> » <a href="/albums{$album->getOwner()->getId()}">{_photos}</a> » {$album->getName()} » {$album->getPhotosCount()} {tr("photos", $album->getPhotosCount())}
    {/if}
{/block}

{block content}

<!-- <div class="album-info-meta">
    
    {* Блок автора альбома *}
    {var $owner = $album->getOwner()}
    {if !is_null($owner)}
        <div class="album-owner-block">
            <a href="{$owner->getURL()}">
                <img src="{$owner->getAvatarURL('b')}" alt="{$owner->getCanonicalName()}" style="width: 50px; margin-right: 10px;">
            </a>

            {var $description = $album->getDescription()}
